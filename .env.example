# Local development only. Copy to .env; never commit real secrets.
NODE_ENV=development

# Web
PORT=3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_REQUIRED=false
AUTH_TOKEN_PEPPER=local-auth-token-pepper-change-me
SESSION_TOKEN_PEPPER=local-session-pepper-change-me-now
CSRF_SECRET=local-csrf-secret-change-me-now-x
# Staging-only read access for automated load checks. Store only the SHA-256 digest here.
STAGING_LOAD_AUTH_ENABLED=false
STAGING_LOAD_LOGIN=
STAGING_LOAD_TOKEN_SHA256=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Ташкалинская фабрика
WEBAUTHN_ORIGINS=http://localhost:3000
# Optional SMS.RU key. Keep the real value only in the deployment secret store.
SMS_RU_API_ID=

# Private photos. Staging/production require FILE_STORAGE_DRIVER=s3.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=var/private-files
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=replace-with-a-separate-secret-at-least-32-characters
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:owner@example.com

# Worker
WORKER_POLL_INTERVAL_MS=5000

# PostgreSQL local/CI. Change credentials outside local development.
POSTGRES_DB=tashkalinskaya
POSTGRES_USER=tashkalinskaya
POSTGRES_PASSWORD=local-only-password
DATABASE_URL=postgresql://tashkalinskaya:local-only-password@localhost:5432/tashkalinskaya
