{
  "name": "factory-staging-70-read",
  "virtualUsers": 70,
  "iterationsPerUser": 20,
  "timeoutMs": 3000,
  "thresholds": {
    "p95Ms": 1000,
    "maxErrorRate": 0.01,
    "maxTotalDurationMs": 120000
  },
  "requests": [
    {
      "name": "attendance-control",
      "method": "GET",
      "path": "/api/v1/attendance/control?date=${LOAD_BUSINESS_DATE}",
      "headers": { "x-staging-load-token": "${LOAD_READ_TOKEN}" },
      "weight": 3,
      "expectedStatuses": [200]
    },
    {
      "name": "production-workspace",
      "method": "GET",
      "path": "/api/v1/production/workspace?productionDate=${LOAD_BUSINESS_DATE}",
      "headers": { "x-staging-load-token": "${LOAD_READ_TOKEN}" },
      "weight": 3,
      "expectedStatuses": [200]
    },
    {
      "name": "warehouse-workspace",
      "method": "GET",
      "path": "/api/v1/warehouse/workspace?date=${LOAD_BUSINESS_DATE}",
      "headers": { "x-staging-load-token": "${LOAD_READ_TOKEN}" },
      "weight": 2,
      "expectedStatuses": [200]
    },
    {
      "name": "reports-control",
      "method": "GET",
      "path": "/api/v1/reports/control?date=${LOAD_BUSINESS_DATE}",
      "headers": { "x-staging-load-token": "${LOAD_READ_TOKEN}" },
      "weight": 1,
      "expectedStatuses": [200]
    }
  ]
}
